<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ═══════════════════════════════════════════════════════════════════════
       CAMERA JOINT
       90° CCW rotation applied to joint origin (new_x=-old_y, new_y=old_x):
         Old xyz: -0.00040887  -0.4   1.2   (camera was in front along old -Y)
         New xyz:  0.4  -0.00040887   1.2   (camera now in front along new +X) ✓

       Yaw updated: old=-1.57 (was cancelling base_joint rotation that no longer
         exists), new=0 (camera faces +X, same as robot forward direction).
         Pitch 0.5 rad (looking slightly downward) is unchanged.
  ════════════════════════════════════════════════════════════════════════════ -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <!-- old xyz="-0.00040887 -0.4 1.2"  rpy="0 0.5 -1.57"
         new xyz=" 0.4 -0.00040887 1.2"  rpy="0 0.5  0"    -->
    <origin xyz="0.4 -0.00040887 1.2" rpy="0 0.5 0"/>
  </joint>

  <!-- ═══════════════════════════════════════════════════════════════════════
       CAMERA LINK — unchanged (geometry is in link's own local frame)
  ════════════════════════════════════════════════════════════════════════════ -->
  <link name="camera_link">
    <inertial>
      <!-- CoM is essentially at (0, 0, -0.024) — no meaningful rotation needed -->
      <origin xyz="1.11022302462516E-16 -6.93889390390723E-18 -0.0237945045054865" rpy="0 0 0"/>
      <mass value="0.159621127501619"/>
      <inertia ixx="4.69332801203968E-05"  ixy="2.61761694080102E-21"  ixz="-5.75604036267865E-21"
               iyy="0.000140683280120397"  iyz="-4.47174067978566E-22"
               izz="0.000157723235148685"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find rover26)/meshes/camera.STL"/></geometry>
      <material name="blue_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="file://$(find rover26)/meshes/camera.STL"/></geometry>
    </collision>
  </link>

  <!-- ═══════════════════════════════════════════════════════════════════════
       CAMERA OPTICAL FRAME JOINT
       Standard ROS optical convention rotation — never change this.
       rpy="-1.5708 0 -1.5708" converts ROS frame (X-fwd,Y-left,Z-up)
       to optical frame (X-right, Y-down, Z-into-image).
  ════════════════════════════════════════════════════════════════════════════ -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <link name="camera_optical_frame"/>

  <!-- ═══════════════════════════════════════════════════════════════════════
       GAZEBO SENSOR PLUGIN — unchanged
  ════════════════════════════════════════════════════════════════════════════ -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>camera/image</topic>
      <update_rate>10</update_rate>
      <frame_id>camera_optical_frame</frame_id>
      <camera>
        <horizontal_fov>1.92</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>